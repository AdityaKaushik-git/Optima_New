# Public site URL, used for canonical links, sitemap.xml and structured data
VITE_SITE_URL=https://www.optimastaruae.com

# Base path. "/" for Vercel/Netlify/custom domain. GitHub Pages project site: /Optima/
VITE_BASE_PATH=/

# Quote form backend. The form POSTs multipart/form-data to ${VITE_API_BASE_URL}${VITE_QUOTE_PATH}.
# Leave empty to fall back to opening the visitor's email app with the details filled in.
VITE_API_BASE_URL=
VITE_QUOTE_PATH=/quote

# WhatsApp number for the chat buttons, digits only with country code
VITE_WHATSAPP_NUMBER=971568180793
